# --- App ---
APP_NAME=VaultAPI
APP_VERSION=1.0.0
ENVIRONMENT=development

# --- Database ---
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./vault.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://vault_user:vault_pass@localhost:5432/vault_db

# --- JWT / Security ---
# Generate a strong secret with: openssl rand -hex 32
SECRET_KEY=replace-me-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- File Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/gif,application/pdf
